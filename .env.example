# LogicPuzzle Lab - Configuration
# Copy to .env for local development

# Server
PORT=5000
FLASK_PORT=5000
FLASK_DEBUG=false
SECRET_KEY=change-me-in-production

# Admin PIN for Kahoot-style exam control
ADMIN_PIN=admin123

# Game settings
GAME_QUESTIONS=15
QUESTION_TIME_SEC=90

# Optional: Redis for multi-worker Socket.IO on Railway
# REDIS_URL=redis://default:password@host:6379

# CORS (use your Railway domain in production)
ALLOWED_ORIGINS=*
